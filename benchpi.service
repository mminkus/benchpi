# Install with:
#   sed "s/YOURUSER/$USER/g; s|YOURHOME|$HOME|" benchpi.service \
#       | sudo tee /etc/systemd/system/benchpi.service
#   sudo systemctl enable --now benchpi
#
# Note that this takes the kernel console off the framebuffer, so the login
# prompt disappears from the LCD. Stopping the service puts it back.

[Unit]
Description=benchpi touchscreen dashboard
Documentation=https://github.com/lvgl/lvgl
After=systemd-user-sessions.service

# If the hat is not attached, benchpi exits immediately. Give up after a few
# tries rather than respawning forever against hardware that is not there.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=YOURUSER
Group=YOURUSER
SupplementaryGroups=video input

# The '+' runs these as root regardless of User=, which is exactly what it is
# for. fbcon otherwise software-blanks the framebuffer out from under LVGL,
# because fbtft implements no fb_blank. See the README.
ExecStartPre=+/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind'
ExecStart=YOURHOME/benchpi/benchpi
ExecStopPost=+/bin/sh -c 'echo 1 > /sys/class/vtconsole/vtcon1/bind'

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
